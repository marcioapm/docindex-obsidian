{
    "name": "obsidian-docindex",
    "version": "0.1.0",
    "description": "Obsidian plugin that queries a remote docindex-server for semantic + BM25 search. Fork of joybro/obsidian-similar-notes.",
    "main": "main.js",
    "scripts": {
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "install-local": "npm run build && ./scripts/install-local.sh",
        "version": "node version-bump.mjs && git add manifest.json versions.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "similar",
        "notes",
        "recommendation",
        "semantic-search",
        "docindex"
    ],
    "author": "Young Lee",
    "license": "MIT",
    "devDependencies": {
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^14.0.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.17.30",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@typescript-eslint/eslint-plugin": "^5.29.0",
        "@typescript-eslint/parser": "^5.29.0",
        "@vitejs/plugin-react": "^4.3.4",
        "builtin-modules": "^3.3.0",
        "esbuild": "^0.25.1",
        "eslint": "^8.57.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "jsdom": "^26.0.0",
        "ts-node": "^10.9.2",
        "tslib": "2.4.0",
        "typescript": "4.7.4",
        "vitest": "^3.0.8"
    },
    "dependencies": {
        "loglevel": "^1.9.2",
        "obsidian": "latest",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "rxjs": "^7.8.2"
    }
}
